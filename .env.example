# Database
DATABASE_URL=postgresql+psycopg://tah:tah@localhost:5432/tah

# Auth
JWT_SECRET=change-me
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me
API_BASE_URL=http://localhost:8000

# --- AI providers -----------------------------------------------------------
# Any OpenAI-compatible endpoint works. Leave every key empty to run fully
# offline: deterministic local embeddings and a grounded answer composed from
# the retrieved passages. Switching provider is an env change, never code.

# Chat generation. For OpenAI, set OPENAI_API_KEY and leave LLM_BASE_URL empty.
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=google/gemma-4-26b-a4b-it:free
# Tried in order when the primary is rate-limited or returns nothing.
LLM_FALLBACK_MODELS=nvidia/nemotron-3-super-120b-a12b:free,nvidia/nemotron-3-ultra-550b-a55b:free

# Embeddings. Changing the model requires a full re-embed:
#   python scripts/reembed.py --run
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=text-embedding-3-large

# Used when LLM_API_KEY / EMBEDDING_API_KEY are empty.
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Sent to OpenRouter for attribution; ignored by other providers.
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=Tomorrow Agent Hub

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=tomorrow-agent-hub
# Only if the bucket was created with a jurisdiction: eu | fedramp
R2_JURISDICTION=

# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM=noreply@example.org

# Crons
CRON_SECRET=change-me
